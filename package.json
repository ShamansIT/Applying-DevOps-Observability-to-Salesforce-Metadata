{
  "name": "sf-observer-order-of-execution",
  "displayName": "Applying DevOps Observability to Salesforce Metadata",
  "description": "IDE-native, pre-deployment observability for Salesforce record-triggered execution flow.",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension/index.cjs",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "sfObserver.reconstruct",
        "title": "Reconstruct record-triggered execution flow",
        "category": "SF Observer"
      },
      {
        "command": "sfObserver.exportJson",
        "title": "Export last run as JSON",
        "category": "SF Observer"
      },
      {
        "command": "sfObserver.exportMarkdown",
        "title": "Export last run as Markdown",
        "category": "SF Observer"
      },
      {
        "command": "sfObserver.exportSvg",
        "title": "Export last run as SVG",
        "category": "SF Observer"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:extension": "esbuild src/extension/index.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension/index.cjs && node scripts/copyAssets.mjs",
    "test:e2e": "npm run build:extension && esbuild test/e2e/index.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/e2e/suite.cjs && esbuild test/e2e/runTest.ts --bundle --platform=node --format=esm --external:vscode --external:@vscode/test-electron --outfile=dist/e2e/runTest.mjs && node dist/e2e/runTest.mjs",
    "lint": "eslint .",
    "format": "prettier --check . --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:write": "prettier --write . --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "build:eval": "esbuild src/evaluation/cli-run.ts --bundle --platform=node --format=esm --external:@salesforce/core --outfile=dist/eval/cli.mjs",
    "eval:pilot": "npm run build:eval && node dist/eval/cli.mjs pilot",
    "eval:main": "npm run build:eval && node dist/eval/cli.mjs main",
    "eval:repeat": "npm run build:eval && node dist/eval/cli.mjs repeat --repeats 5",
    "eval:aggregate": "npm run build:eval && node dist/eval/cli.mjs aggregate",
    "eval:stats": "python scripts/stats.py",
    "eval:stats:selftest": "python scripts/stats.py --selftest"
  },
  "dependencies": {
    "@salesforce/core": "8.32.4",
    "fast-xml-parser": "5.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/vscode": "1.125.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vscode/test-electron": "3.0.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
